      // [prd]
      const firebaseConfig = {
        apiKey: "AIzaSyD2PyiSNsGq4h_JLpLPRDxnWLoJQf7tvkc",
        appId: "1:462778491182:web:bf231ba1f448edab3f9abf",
        messagingSenderId: "462778491182",
        projectId: "sv-battle-memories",
        authDomain: "sv-battle-memories.firebaseapp.com",
