      const analytics = getAnalytics(app);
    </script>
    <!-- デプロイ版が変わったら古い Service Worker / Cache Storage を自動解除してから Flutter を起動 -->
    <script>
      (function () {
        var DEPLOY_VERSION = "2.5.1+783";

        function loadFlutter() {
          var s = document.createElement("script");
          s.src =
            "flutter_bootstrap.js?v=" + encodeURIComponent(DEPLOY_VERSION);
          s.async = true;
          document.body.appendChild(s);
        }

        var storageKey = "pbl_deploy_version";
        var needsMigrate = true;
        try {
          needsMigrate = localStorage.getItem(storageKey) !== DEPLOY_VERSION;
        } catch (e) {}

        if (!needsMigrate) {
          loadFlutter();
          return;
        }

        var finished = false;
        function finishMigration() {
          if (finished) return;
          finished = true;
          try {
            localStorage.setItem(storageKey, DEPLOY_VERSION);
          } catch (e) {}
          loadFlutter();
        }

        if (!("serviceWorker" in navigator)) {
          finishMigration();
          return;
        }

        Promise.all([
          navigator.serviceWorker.getRegistrations().then(function (regs) {
            return Promise.all(
              regs.map(function (r) {
                return r.unregister();
              })
            );
          }),
          "caches" in window
            ? caches.keys().then(function (keys) {
                return Promise.all(
                  keys.map(function (k) {
                    return caches.delete(k);
                  })
                );
              })
            : Promise.resolve(),
        ])
          .then(finishMigration)
          .catch(finishMigration);

        setTimeout(finishMigration, 4000);
      })();
    </script>

